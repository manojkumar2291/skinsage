{
  "info": {
    "name": "FastAPI Auth Backend",
    "_postman_id": "a9d2d583-98d3-4e64-9b10-0040baf8c932",
    "description": "Authentication API Collection for FastAPI Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register (Email + Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/auth/register",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["auth", "register"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Manoj\",\n  \"email\": \"manoj@example.com\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Login (Email + Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/auth/login",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"manoj@example.com\",\n  \"password\": \"Password123\"\n}"
        }
      }
    },
    {
      "name": "Google Sign-In",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/auth/google-signin",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["auth", "google-signin"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<GOOGLE_ID_TOKEN>\"\n}"
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/auth/refresh",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["auth", "refresh"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"<REFRESH_TOKEN>\"\n}"
        }
      }
    },
    {
      "name": "Get Current User (Protected)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <ACCESS_TOKEN>"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:8000/user/me",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["user", "me"]
        }
      }
    }
  ]
}
